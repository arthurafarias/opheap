@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT TARGET opheap::opheap)
    find_dependency(opheap CONFIG)
endif()
if(NOT TARGET opheap::json)
    find_dependency(opheap-utils-serialization-json CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/opheapModuleCliTargets.cmake")
check_required_components(opheap-module-cli)
