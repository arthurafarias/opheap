              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Admin-Token", "value": "{{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"principal\":\"{{rateLimitPrincipal}}\",\"secret\":\"{{primarySecret}}\"}"
            },
            "url": {
