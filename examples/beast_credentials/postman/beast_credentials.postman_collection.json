  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "    var runId = Date.now() + '-' + Math.floor(Math.random() * 100000);",
          "    pm.collectionVariables.set('runId', runId);",
          "    pm.collectionVariables.set('primaryPrincipal', 'test-user-' + runId);",
          "    pm.collectionVariables.set('primarySecret', 'correct horse battery staple');",
          "    pm.collectionVariables.set('rateLimitPrincipal', 'rate-user-' + runId);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080" },
    { "key": "adminToken", "value": "test-admin-token" },
    { "key": "runId", "value": "" },
    { "key": "primaryPrincipal", "value": "" },
    { "key": "primarySecret", "value": "" },
    { "key": "rateLimitPrincipal", "value": "" },
    { "key": "wrongSecretCode", "value": "" },
    { "key": "wrongSecretBody", "value": "" }
